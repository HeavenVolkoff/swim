{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  minimumReleaseAge: "3 days",
  labels: ["dependencies"],

  // Custom regex managers for build.zig.zon dependencies
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^build\\.zig\\.zon$/"],
      matchStrings: [
        "github\\.com/(?<depName>[^/]+/[^/]+)/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz",
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{{depName}}}.git",
      versioningTemplate: "git"
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build\\.zig\\.zon$/"],
      matchStrings: [
        "github\\.com/(?<depName>[^/]+/[^/]+)/archive/(?<currentValue>v?[0-9]+\\.[^/]+)\\.tar\\.gz",
        "(?<depName>[^/]+/[^/]+)/archive/refs/tags/(?<currentValue>v?[0-9]+\\.[^/]+)\\.tar\\.gz",
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver"
    }
  ],

  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      schedule: ["before 6:00 am on monday"]
    },
    {
      matchManagers: ["custom.regex"],
      groupName: "Zig Dependencies"
    }
  ]
}
